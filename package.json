{
  "name": "shcontext",
  "version": "0.1.0-alpha.1",
  "description": "Source-referenced repository context generator (alpha).",
  "private": true,
  "license": "MIT",
  "author": "HarshPopat23",
  "type": "module",
  "engines": {
    "node": "^22.14.0 || ^24.0.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshPopat23/SHContext.git"
  },
  "homepage": "https://github.com/HarshPopat23/SHContext#readme",
  "bugs": {
    "url": "https://github.com/HarshPopat23/SHContext/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./contracts": {
      "types": "./dist/core/contracts/index.d.ts",
      "import": "./dist/core/contracts/index.js"
    },
    "./package.json": "./package.json",
    "./scanner": {
      "types": "./dist/scanner/index.d.ts",
      "import": "./dist/scanner/index.js"
    },
    "./analysis": {
      "types": "./dist/core/analyze-repository.d.ts",
      "import": "./dist/core/analyze-repository.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "import": "./dist/generation/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./update": {
      "types": "./dist/update/index.d.ts",
      "import": "./dist/update/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    }
  },
  "bin": {
    "shcontext": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "src/**/*.ts",
    "docs/",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "skills/",
    ".claude-plugin/",
    "benchmarks/agent-results.md",
    "benchmarks/agent-results.json",
    "benchmarks/results/",
    "benchmarks/datasets/",
    "CHANGELOG.md",
    "scripts/ci-freshness.mjs",
    "examples/offline-demo.mjs",
    "examples/host-demo.mjs"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "cli": "node dist/cli/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "check": "npm run format:check && npm run typecheck && npm test",
    "test:integration": "npm run build && node --test --test-concurrency=1 tests/cli.test.mjs tests/build-cli.test.mjs tests/verify-cli.test.mjs tests/update-cli.test.mjs tests/query-cli.test.mjs tests/agents-cli.test.mjs tests/package.test.mjs",
    "benchmark:agents": "npm run build && node benchmarks/agents.mjs",
    "test:skills": "node --test --test-concurrency=1 tests/skills.test.mjs tests/skills-install.test.mjs",
    "test:plugin": "node scripts/check-plugin.mjs",
    "benchmark:quality": "npm run build && node benchmarks/quality.mjs",
    "benchmark:real": "npm run build && node benchmarks/real.mjs",
    "test:evaluation": "npm run build && node --test --test-concurrency=1 tests/evaluation.test.mjs",
    "release:pack": "node scripts/package-release.mjs",
    "test:release": "node --test --test-concurrency=1 tests/release.test.mjs",
    "benchmark:live": "npm run build && node benchmarks/live.mjs"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.28.0",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "@babel/types": "7.29.8",
    "ignore": "7.0.13",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.7"
  }
}
