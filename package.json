{
  "name": "shcontext",
  "version": "0.0.0",
  "description": "Repository context generator — development foundation.",
  "private": true,
  "license": "MIT",
  "author": "HarshPopat23",
  "type": "module",
  "engines": {
    "node": "^22.14.0 || ^24.0.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshPopat23/SHContext.git"
  },
  "homepage": "https://github.com/HarshPopat23/SHContext#readme",
  "bugs": {
    "url": "https://github.com/HarshPopat23/SHContext/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "shcontext": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "src/**/*.ts",
    "docs/",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "cli": "node dist/cli/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
